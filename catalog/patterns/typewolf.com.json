{
  "match": "/{name}",
  "exclude": [
    "/about",
    "/adobe-fonts",
    "/all-fonts",
    "/amazon",
    "/archive",
    "/best-sites",
    "/design-studios",
    "/favorite-sites",
    "/portfolio-sites",
    "/shopify-ecommerce-sites",
    "/blog",
    "/cheatsheet",
    "/checklist",
    "/checklist-help",
    "/free-fonts",
    "/google-fonts",
    "/guide-to-adobe-fonts",
    "/guides",
    "/lookbooks",
    "/mac-fonts",
    "/newsletter",
    "/not-on-google-fonts",
    "/popular-fonts-next-year",
    "/recommendations",
    "/resources",
    "/type-sample",
    "/typography-books",
    "/top-10-{name}"
  ],
  "granularity": "page",
  "status": "hand",
  "note": "Typewolf: each root-level slug is one font family page ('Work Sans Font Combinations & Similar Fonts', 1144 fonts). The 22 non-font pages (about, all-fonts, guides, checklist, best-sites …) and the 18 /top-10-<topic> listicles are excluded; /blog posts are not items."
}
