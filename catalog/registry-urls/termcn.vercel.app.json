{
  "templates": [
    "https://www.termcn.dev/docs/{name}"
  ],
  "rewrite": [
    [
      "^ink/(dither-sparkline|gauge|heat-map|sparkline)$",
      "charts/ink/$1"
    ],
    [
      "^ink/(chat-message|chat-thread|conversation-history|error-retry|file-change|model-selector|streaming-text|thinking-block|token-usage|tool-approval|tool-call)$",
      "components/ink/ai/$1"
    ],
    [
      "^ink/(card|data-grid|definition|diff-view|directory-tree|git-status|json|key-value|list|table|tree|virtual-list)$",
      "components/ink/data/$1"
    ],
    [
      "^ink/(alert|banner|multi-progress|progress-bar|progress-circle|skeleton|spinner|status-message|toast)$",
      "components/ink/feedback/$1"
    ],
    [
      "^ink/(confirm|date-picker|file-picker|form|form-field|time-picker|wizard)$",
      "components/ink/forms/$1"
    ],
    [
      "^ink/(email-input|masked-input|number-input|password-input|path-input|search-input|text-area|text-input)$",
      "components/ink/input/$1"
    ],
    [
      "^ink/(aspect-ratio|box|center|columns|divider|grid|scroll-view|spacer|stack)$",
      "components/ink/layout/$1"
    ],
    [
      "^ink/(breadcrumb|command-palette|menu|pagination|sidebar|tabbed-content|tabs)$",
      "components/ink/navigation/$1"
    ],
    [
      "^ink/(dialog|drawer|modal|notification-center|popover|tooltip)$",
      "components/ink/overlays/$1"
    ],
    [
      "^ink/(checkbox|checkbox-group|color-picker|multi-select|radio-group|select|tag-input|tree-select)$",
      "components/ink/selection/$1"
    ],
    [
      "^ink/(badge|big-text|code|digits|gradient|heading|link|markdown|tag)$",
      "components/ink/typography/$1"
    ],
    [
      "^ink/(clipboard|clock|embedded-terminal|error-boundary|help|image|keyboard-shortcuts|log|panel|qr-code|stopwatch|timer|toggle)$",
      "components/ink/utility/$1"
    ],
    [
      "^ink/(app-shell|bullet-list|help-screen|info-box|login-flow|setup-flow|splash-screen|usage-monitor|welcome-screen)$",
      "templates/ink/$1"
    ],
    [
      "^opentui/(dither-sparkline|gauge|heat-map|sparkline)$",
      "charts/opentui/$1"
    ],
    [
      "^opentui/(chat-message|chat-thread|file-change|model-selector|streaming-text|thinking-block|token-usage|tool-approval|tool-call)$",
      "components/opentui/ai/$1"
    ],
    [
      "^opentui/(card|data-grid|definition|diff-view|directory-tree|git-status|json|key-value|list|table|tree|virtual-list)$",
      "components/opentui/data/$1"
    ],
    [
      "^opentui/(alert|banner|multi-progress|progress-bar|progress-circle|skeleton|spinner|status-message|toast)$",
      "components/opentui/feedback/$1"
    ],
    [
      "^opentui/(confirm|date-picker|file-picker|form|form-field|time-picker|wizard)$",
      "components/opentui/forms/$1"
    ],
    [
      "^opentui/(email-input|masked-input|number-input|password-input|path-input|search-input|text-area|text-input)$",
      "components/opentui/input/$1"
    ],
    [
      "^opentui/(aspect-ratio|box|center|columns|divider|grid|scroll-view|spacer|stack)$",
      "components/opentui/layout/$1"
    ],
    [
      "^opentui/(breadcrumb|command-palette|menu|pagination|sidebar|tabbed-content|tabs)$",
      "components/opentui/navigation/$1"
    ],
    [
      "^opentui/(dialog|drawer|modal|notification-center|popover|tooltip)$",
      "components/opentui/overlays/$1"
    ],
    [
      "^opentui/(checkbox|checkbox-group|color-picker|multi-select|radio-group|select|tag-input|tree-select)$",
      "components/opentui/selection/$1"
    ],
    [
      "^opentui/(badge|big-text|code|digits|gradient|heading|link|markdown|tag)$",
      "components/opentui/typography/$1"
    ],
    [
      "^opentui/(clipboard|clock|embedded-terminal|error-boundary|help|image|keyboard-shortcuts|log|panel|qr-code|stopwatch|timer|toggle)$",
      "components/opentui/utility/$1"
    ],
    [
      "^opentui/(app-shell|bullet-list|help-screen|info-box|login-flow|setup-flow|splash-screen|usage-monitor|welcome-screen)$",
      "templates/opentui/$1"
    ],
    [
      "^(ink|opentui)/(bar|dither-area|dither-bar|dither-line|dither-pie|dither-radar|line|pie)-chart$",
      "charts/$1/$2"
    ]
  ],
  "status": "hand",
  "note": "termcn.vercel.app 301s to www.termcn.dev (same site). Registry slugs carry the theme prefix: 'ink/alert', 'opentui/select'. One page per component/template/chart under /docs/{components|templates|charts}/<theme>[/<category>]/<name> — e.g. ink/alert → /docs/components/ink/feedback/alert, ink/app-shell → /docs/templates/ink/app-shell, ink/bar-chart → /docs/charts/ink/bar. The rewrite maps each <theme>/<name> to its section path (26 group rules, one per section+theme+category, names taken from the docs index pages of both themes — the site's sitemap lists only 292 of the 358 page paths, e.g. no opentui selection/layout/overlays pages); chart names lose their '-chart' suffix (charts rule). Fills 238 of the 245 ui/block items. Still url-less: the theme/motion/unicode providers and opentui/notification-badge — no page. robots.txt allows /. Unknown paths 404 with title 'Page Not Found | termcn' (no soft-404)."
}
